{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "./source",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["*.ts", "source/main.ts"],
    "exclude": ["node_modules", "dist"]
}